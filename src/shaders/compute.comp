#version 450
#extension GL_ARB_separate_shader_objects : enable

#define WORKGROUP_SIZE 32
layout(local_size_x = WORKGROUP_SIZE) in;

struct Blade {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 up;
};

layout(std430, set = 2, binding = 0) readonly buffer InputBlades {
    Blade blades[];
} inputBlades;

layout(std430, set = 2, binding = 1) writeonly buffer OutputBlades {
    Blade blades[];
} outputBlades;

layout(std430, set = 2, binding = 2) writeonly buffer NumBlades {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} numBlades;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint count = uint(inputBlades.blades.length());
    if (index >= count) return;

    // Keep every blade for the static rendering stage.
    outputBlades.blades[index] = inputBlades.blades[index];
    if (index == 0) {
        numBlades.vertexCount = count;
        numBlades.instanceCount = 1;
        numBlades.firstVertex = 0;
        numBlades.firstInstance = 0;
    }
}
